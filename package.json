{
  "name": "paseo-multi-host-manager",
  "version": "0.0.1",
  "description": "Paseo plugin: settings and plugins of every saved Paseo host in one grid, copied between hosts on request",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "multi-host",
    "settings",
    "plugins",
    "sync"
  ],
  "license": "MIT",
  "author": "Bernhard Millauer, adventics Service GmbH",
  "type": "module",
  "homepage": "https://github.com/SeriousM/paseo-multi-host-manager",
  "bugs": {
    "url": "https://github.com/SeriousM/paseo-multi-host-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeriousM/paseo-multi-host-manager.git"
  },
  "files": [
    "npm-shrinkwrap.json",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.server.ts",
    "index.client.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "cross-env MHM_TESTENV=1 vitest run --config vitest.integration.config.ts",
    "matrix": "node testenv/matrix.mjs",
    "pack:check": "node tools/pack-check.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@getpaseo/plugin": "0.14.0",
    "@getpaseo/protocol": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  }
}
