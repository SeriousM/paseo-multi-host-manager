{
  "id": "paseo-multi-host-manager",
  "name": "Multi-Host Manager",
  "description": "Shows the settings and plugins of every saved Paseo host in one grid and copies them between hosts",
  "media": [
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-grid.png",
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-baseline.png",
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-apply.png",
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-editor.png",
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-compact.png",
    "https://raw.githubusercontent.com/SeriousM/paseo-multi-host-manager/main/assets/screenshot-add-host.png"
  ],
  "requirements": {
    "paseo": ">=0.13.0"
  },
  "build": [["npm", "ci", "--omit=dev", "--ignore-scripts", "--no-audit", "--no-fund"]]
}
